# PI-AU production env template — copy to `.env.production.local` and fill in.
# scripts/deploy.sh env-up reads this file and pushes each value to Vercel.
# DATABASE_URL is NOT here — it's auto-provisioned by Vercel Postgres.

# ─── App URL (set after first deploy; Vercel assigns a stable domain) ────────
NEXT_PUBLIC_APP_URL=https://project-intelligence-au.vercel.app

# Logical environment label for this Vercel project. Drives the [STAGING]
# subject prefix + sender display-name suffix on outbound email so a tester
# receiving mail from both envs at the same address can tell them apart.
# Allowed: development | staging | production. Production deploys = production.
STAGE=production

# ─── AI ──────────────────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
USD_TO_AUD=1.52

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# https://resend.com/api-keys (after domain DNS is verified)
RESEND_API_KEY=

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys (use LIVE keys for production)
STRIPE_SECRET_KEY=sk_live_
# https://dashboard.stripe.com/webhooks (whsec_... signing secret of the prod webhook)
STRIPE_WEBHOOK_SECRET=whsec_
# https://dashboard.stripe.com/products — create Solo $199/mo and Team $499/mo
STRIPE_PRICE_ID_SOLO=price_
STRIPE_PRICE_ID_TEAM=price_

# ─── SMS fallback (Twilio) — optional Month 1 ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Feedback links ──────────────────────────────────────────────────────────
# 32+ random bytes. Generate fresh: openssl rand -base64 32
FEEDBACK_HMAC_SECRET=

# ─── Vercel cron auth ────────────────────────────────────────────────────────
# 32+ random bytes. Generate fresh: openssl rand -base64 32
CRON_SECRET=

# ─── Data sources — optional Month 1 (human-loop fallback active) ────────────
NSW_PLANNING_API_KEY=
DA_LEADS_API_KEY=
# DA Exhibitions HTML scrape — public NSW Planning Portal register at
# /daexhibitions. Covers all 15 LGAs, no API key required. When set to
# "true" the daily ingest cron pulls from this source by default.
DAEX_INGEST_ENABLED=false
# State Significant Development register at /major-projects/projects.
# Dormant Teams-tier feature — schools, hospitals, public infrastructure,
# >$30m projects. Adapter exists (fetchSsdProjects) but is NOT wired into
# the standard fetchCouncilDAs() dispatcher. Flip this on when the Teams
# subscription tier ships and routes its own cron through the SSD path.
SSD_INGEST_ENABLED=false

# ─── Vertical packs — multi-trade expansion (docs/25 §2), dormant ────────────
# Trades beyond roofing (V1) ship behind per-trade flags, default off. The pack
# + seed eval set are built and merged; launching the trade is a human-owned
# go/no-go, executed by flipping the flag to "true". Demolition = trade #2
# candidate (mandatory DA/CDC → high recall in planning data).
VERTICAL_DEMOLITION_ENABLED=false

# ─── Observability — recommended Month 1 ─────────────────────────────────────
# https://sentry.io → create project → Settings → Client Keys (DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# https://posthog.com → project settings → API key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
