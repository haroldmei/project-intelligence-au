{
  "name": "pi-au",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "vercel-build": "prisma generate && prisma migrate deploy && prisma db seed && tsx --env-file-if-exists=.env.local scripts/dev-seed.ts && next build",
    "dev:seed": "tsx --env-file-if-exists=.env.local scripts/dev-seed.ts",
    "test:emails": "vitest run evals/emails/render-snapshots.test.ts",
    "test:billing": "vitest run -c vitest.backend.config.ts __tests__/billing __tests__/webhooks/stripe.test.ts",
    "test:billing:prod": "playwright test -c playwright.prod.config.ts",
    "import-das": "tsx --env-file-if-exists=.env.local scripts/import-das.ts",
    "import-das:prod": "tsx --env-file-if-exists=.env.production.local scripts/import-das.ts",
    "digest:now": "tsx --env-file-if-exists=.env.local scripts/run-digest-now.ts",
    "digest:now:prod": "tsx --env-file-if-exists=.env.production.local scripts/run-digest-now.ts",
    "check-daex": "tsx --env-file-if-exists=.env.production.local scripts/check-daex.ts",
    "ingest:now": "tsx --env-file-if-exists=.env.local scripts/run-ingest-now.ts",
    "ingest:now:prod": "tsx --env-file-if-exists=.env.production.local scripts/run-ingest-now.ts",
    "eval:rerank": "promptfoo eval --config evals/rerank/promptfooconfig.yaml --no-cache"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@lucia-auth/adapter-prisma": "^4.0.1",
    "@prisma/client": "^5.22.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.7",
    "@sentry/nextjs": "^8.55.2",
    "argon2": "^0.44.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "lucia": "^3.2.2",
    "lucide-react": "^0.511.0",
    "next": "15.5.15",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "prisma": "^5.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.74.0",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "fast-check": "^4.7.0",
    "jsdom": "^29.1.0",
    "promptfoo": "^0.121.9",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
