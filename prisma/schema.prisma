// WEDGE: The Sunday-night roofing DA digest for Sydney subbies — 15 LGAs, 5–15 leads, AUD 199/mo, signup in 60 seconds.
// Stack contract: docs/00-tech-stack.md @ 2026-Q2
// ORM: prisma 5 | DB: postgres 16 + pgvector 0.7 | Auth: lucia + argon2id

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public"), citext]
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique /// citext in DB (case-insensitive); enforced by Prisma
  passwordHash  String   @map("password_hash")
  mobile_e164   String?
  emailVerified Boolean  @default(false) @map("email_verified")
  // Signup requires and collects a verified AU mobile and the landing page
  // sells "Email + SMS" — so the SMS channel is opted-IN by default, matching
  // spec SF-3.4 ("toggle … defaulting to ON") and UX §7.9 ("[◑ ON]"). The
  // signup route also sets this explicitly at the consent point; STOP (Twilio
  // webhook) and the /account toggle are the opt-out path. Changing this
  // default only affects new rows — existing users keep their stored value.
  smsOptIn      Boolean  @default(true) @map("sms_opt_in")
  // Spam Act 2003: a functional unsubscribe honoured with no login/fee.
  // Defaults true (commercial email flows from signup); the token-based
  // /api/unsubscribe/[token] link flips it false, gated in the digest +
  // trial-reminder send paths.
  emailOptIn    Boolean  @default(true) @map("email_opt_in")
  // Per-user opt-out for the mid-week BOM storm brief (#20). Defaults true
  // (opted-in) while the feature stays globally gated behind STORM_BRIEF_ENABLED;
  // the /account toggle lets a user opt out ahead of the global launch. The
  // storm-brief cron ANDs this with emailOptIn (Spam Act functional unsubscribe).
  stormBriefOptIn Boolean @default(true) @map("storm_brief_opt_in")
  trade         String   @default("roofing")

  // Billing
  subscriptionStatus  String  @default("trial") @map("subscription_status") // trial|active|cancelled|past_due
  accessUntil         DateTime? @map("access_until")
  stripeCustomerId    String?   @unique @map("stripe_customer_id")
  plan                String?   @map("plan") // solo|team — captured from Stripe on subscription event
  cancelAtPeriodEnd   Boolean   @default(false) @map("cancel_at_period_end")
  // Day-26 trial-reminder dedupe. Cron sets when sent so a redelivery or
  // timezone drift can't double-send.
  trialReminderSentAt DateTime? @map("trial_reminder_sent_at")
  // FR-016 verification-reminder dedupe. An unverified signup receives no
  // digest (the Sunday cron gates on emailVerified). The daily
  // verification-reminder cron nudges them once, before the Thursday preceding
  // their first expected Sunday digest; this stamp ensures at most one nudge.
  verificationReminderSentAt DateTime? @map("verification_reminder_sent_at")
  // Churn signal captured by the in-product cancel dialog (#96 A5). A closed
  // set of reason codes ("too_expensive" | "not_enough_leads" | ...), never
  // free-text PII. Last cancel wins; a resume leaves it in place as history.
  cancellationReason  String?   @map("cancellation_reason")

  // Saved roofing query (LGA bundle ids stored in LgaBundleSubscription)
  savedQueryText String? @map("saved_query_text")
  // vector(1536) stored as Unsupported until Prisma native vector support
  savedQueryEmbedding Unsupported("vector(1536)")? @map("saved_query_embedding")

  personalisationNotifiedAt DateTime? @map("personalisation_notified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions          Session[]
  emailOtps         EmailOtp[]
  lgaBundles        LgaBundleSubscription[]
  digests           Digest[]
  daFeedback        DaFeedback[]
  aiCostLog         AiCostLog[]
  userConsent       UserConsent?
  teamMemberships   TeamMembership[]
  ownedTeam         TeamAccount?
  digestCandidates  DigestCandidate[]
  stormBriefs       StormBrief[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailOtp {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  codeHash    String    @map("code_hash")  // bcrypt or argon2id hash of 6-digit code
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  purpose     String    @default("verify") // verify|reset|login
  // Failed-guess counter (issue #126). verifyAndConsumeOtp increments this on a
  // wrong code and burns the OTP once it crosses the limit, so a single 6-digit
  // code can't be brute-forced even if a rate-limit window rolls over.
  attemptCount Int      @default(0) @map("attempt_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_otps")
}

model UserConsent {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  posthogConsent  Boolean  @default(false) @map("posthog_consent")
  consentedAt     DateTime? @map("consented_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consent")
}

// ─── LGA Bundles ─────────────────────────────────────────────────────────────

model LgaBundle {
  id    String @id // e.g. "western_sydney"
  label String

  lgas          Lga[]
  subscriptions LgaBundleSubscription[]

  @@map("lga_bundles")
}

model Lga {
  id       String @id // council slug
  bundleId String @map("bundle_id")
  name     String
  // Statewide jurisdiction this LGA belongs to (nsw|sa|…). The multi-jurisdiction
  // seam (#28); defaults 'nsw' so pre-existing reference rows backfill in place.
  jurisdiction String @default("nsw")

  bundle              LgaBundle              @relation(fields: [bundleId], references: [id])
  developmentApps     DevelopmentApplication[]

  @@map("lgas")
}

model LgaBundleSubscription {
  userId   String @map("user_id")
  bundleId String @map("bundle_id")

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundle LgaBundle @relation(fields: [bundleId], references: [id])

  @@id([userId, bundleId])
  @@map("lga_bundle_subscriptions")
}

// ─── Development Applications ────────────────────────────────────────────────

model DevelopmentApplication {
  id             String   @id @default(cuid())
  daId           String   @map("da_id")      // council-issued DA reference
  council        String
  address        String
  description    String
  estimatedValue Decimal? @map("estimated_value")
  lodgementDate  DateTime @map("lodgement_date") @db.Date
  // Council's decision date — only populated for Determined-status DAs from
  // the DAEX adapter. The "freshness signal" used by the ingest filter to
  // drop stale leads (>180 days old determined DAs are noise — the project
  // has either already built or been abandoned).
  determinationDate DateTime? @map("determination_date") @db.Date
  // Date a Construction Certificate was issued against this DA/CDC (issue #13).
  // A CC means work is about to START — the "work starting now" timing signal,
  // distinct from lodgement (6–18mo out) and determination (approved, not yet
  // begun). Populated by the Online PCC Data API adapter (src/modules/ingestion/
  // pcc.ts) linking CC records back to their related application by (da_id,
  // council). Null until a CC is issued — the vast majority of rows. Mirrors
  // determination_date: a single nullable date, no separate table needed for the
  // v1 "date + badge" signal.
  constructionCertifiedAt DateTime? @map("construction_certified_at") @db.Date
  applicantName  String?  @map("applicant_name")
  portalUrl      String   @map("portal_url")
  rawScopeText   String?  @map("raw_scope_text")
  // Categorical "Type of development" the portal assigns (e.g. NSW DAEX
  // "Alterations and additions to residential development"; SSD "HDA Housing").
  // The expansion trade-pick (docs/25 §1.1) needs to know whether demolition /
  // pool / subdivision are cleanly category-filterable — so we persist the raw
  // category verbatim rather than fold it only into raw_scope_text (#26). Null
  // for feeds that expose no category (NSW Planning API, DA Leads, PlanSA), the
  // same way estimated_value is null for value-less feeds.
  developmentType String? @map("development_type")
  sourceApi      String   @map("source_api")  // nsw_planning|da_leads|council_da|da_exhibitions|nsw_cdc|plansa
  // Which NSW planning approval pathway carried this record (#10):
  //   da  — a Development Application (the incumbent feeds; the default).
  //   cdc — a Complying Development Certificate from the Online CDC Data API.
  //         The pathway that actually carries material-change re-roofs
  //         (tile→metal), which never generate a DA (docs/24 G1). daId is
  //         namespaced with a `CDC-` prefix at ingest so a CDC number can never
  //         collide with a DA of the same council-issued reference.
  //   ssd — State Significant Development (dormant Teams-tier feed).
  // Persisted so the reranker/lead-class can treat "CDC re-roof" as a strong
  // positive and the digest can group by pathway. Defaults 'da' so every
  // pre-#10 row backfills in place and NSW DA output stays byte-identical.
  approvalPathway String  @default("da") @map("approval_pathway")
  // Statewide jurisdiction this DA belongs to (nsw|sa|…). The multi-jurisdiction
  // seam (#28); defaults 'nsw' so pre-existing rows backfill in place and NSW
  // output is byte-identical.
  jurisdiction   String   @default("nsw")
  ruleFilteredOut Boolean @default(false) @map("rule_filtered_out")
  // Reason this DA was excluded (null = not excluded; rule_filter_miss = failed
  // the roofing keyword rule pass; refused_withdrawn = determined Refused/WD).
  // Keeps the two meanings distinct for the eval harness's 'misses' stratum
  // (FR-004 recall audit) and the status-exclusion path (#221).
  excludedReason String? @map("excluded_reason")
  ingestedAt     DateTime @default(now()) @map("ingested_at")

  lgaId String? @map("lga_id")
  lga   Lga?    @relation(fields: [lgaId], references: [id])

  embedding    DaEmbedding?
  daFeedback   DaFeedback[]
  digestDas    DigestDa[]
  groundTruth  DaGroundTruth[]

  @@unique([daId, council])
  @@index([council, lodgementDate(sort: Desc)])
  @@index([council, determinationDate(sort: Desc)])
  @@map("development_applications")
}

model DaEmbedding {
  daId       String   @id @map("da_id")
  // vector(1536) — pgvector; stored as Unsupported
  embedding  Unsupported("vector(1536)")
  embeddedAt DateTime @default(now()) @map("embedded_at")

  da DevelopmentApplication @relation(fields: [daId], references: [id], onDelete: Cascade)

  @@map("da_embeddings")
}

model DaGroundTruth {
  id          String   @id @default(cuid())
  daId        String   @map("da_id")
  council     String
  isRelevant  Boolean  @map("is_relevant")
  labelledBy  String   @map("labelled_by")
  // The (trade, region) the label was made under (#31). A gold set is scoped to
  // one (vertical, jurisdiction) so every future launch inherits the same GA
  // gate; existing rows are the roofing/NSW wedge, hence the defaults (which
  // also backfill in place at migration time).
  vertical     String  @default("roofing")
  jurisdiction String  @default("nsw")
  // Provenance of the label (#19): `manual` = a human labelled it in the
  // scripts/label-das.ts CLI; `thumb` = imported from a DaFeedback thumbs-up/down
  // as a *candidate* label pending human review before it counts toward the gate.
  source      String   @default("manual")
  labelledAt  DateTime @default(now()) @map("labelled_at")

  da DevelopmentApplication @relation(fields: [daId], references: [id], onDelete: Cascade)

  // One label per (DA, labeller) — lets multiple labellers score the same DA for
  // inter-rater agreement (Cohen's κ, docs/01b §599) and makes the labelling CLI
  // and thumb-import idempotent via upsert.
  @@unique([daId, labelledBy])
  @@map("da_ground_truth")
}

// ─── Digest ───────────────────────────────────────────────────────────────────

model DigestRun {
  id          String    @id @default(cuid())
  runDate     DateTime  @map("run_date") @db.Date
  triggeredAt DateTime  @default(now()) @map("triggered_at")
  completedAt DateTime? @map("completed_at")
  userCount   Int       @default(0) @map("user_count")
  status      String    @default("running") // running|done|failed
  fallbackUsed Boolean  @default(false) @map("fallback_used")
  // Stable per-week idempotency key: the UTC-Sunday 00:00 instant for weekly
  // cron runs (= cronWeekStartUtc(), src/lib/cron/retry.ts). Two overlapping
  // cron ticks for the same week compute the identical key, so the unique
  // constraint lets them share ONE run instead of each creating a fresh one
  // and double-sending (issue #93). NULL for ad-hoc preview runs
  // (src/modules/digest/preview.ts) — Postgres treats NULLs as distinct, so
  // any number of previews coexist without ever colliding here.
  weekKey     DateTime? @unique @map("week_key")

  digests Digest[]

  @@map("digest_runs")
}

model Digest {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  runId       String    @map("run_id")
  sentAt      DateTime? @map("sent_at")
  daCount     Int       @default(0) @map("da_count")
  emailStatus String?   @map("email_status")
  smsStatus   String?   @map("sms_status")
  fallbackUsed Boolean  @default(false) @map("fallback_used")
  // Send-time snapshot of the user's service-area label, e.g. "Western Sydney +
  // Northern Sydney" (issue #138). The history list and digest-detail header must
  // show what a PAST digest actually covered, not the user's CURRENT area — a
  // tradie who later widened their area would otherwise see old digests falsely
  // relabelled. Frozen here at create time so it never drifts. NULL for digests
  // sent before this column existed; the portal falls back to the live area only
  // for those legacy rows.
  areaLabel   String?   @map("area_label")

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  run     DigestRun @relation(fields: [runId], references: [id])
  digestDas DigestDa[]
  digestCandidates DigestCandidate[]

  // At most one Digest per (user, run). Enforces re-send protection at the DB
  // level (issue #93): two overlapping cron invocations for the same week can't
  // both create a Digest and both email the user — the loser of the create race
  // hits this constraint (P2002) and backs off without sending. The composite
  // also serves the userId-prefix lookups that the old @@index([userId]) did.
  @@unique([userId, runId])
  @@map("digests")
}

model DigestDa {
  id             String @id @default(cuid())
  digestId       String @map("digest_id")
  daId           String @map("da_id")
  relevanceScore Int    @map("relevance_score") // 0–10
  whyMatched     String @map("why_matched")
  rank           Int
  // Honest lead class (issue #14): builder_pipeline | fast_track | strata_heritage.
  // Computed deterministically at assembly time from the DA's approval pathway +
  // scope keywords (src/modules/relevance/lead-class.ts) and PERSISTED here so a
  // digest's classification never drifts when the classifier rules evolve.
  // Defaults to the ambiguous fallback so pre-existing rows backfill in place.
  leadClass      String @default("builder_pipeline") @map("lead_class")

  digest Digest                 @relation(fields: [digestId], references: [id], onDelete: Cascade)
  da     DevelopmentApplication @relation(fields: [daId], references: [id])

  @@map("digest_das")
}

// ─── Feedback ────────────────────────────────────────────────────────────────

model DaFeedback {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  daId      String   @map("da_id")
  feedback  String   // up|down
  source    String   @default("portal") // email|portal
  createdAt DateTime @default(now()) @map("created_at")

  user User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  da   DevelopmentApplication @relation(fields: [daId], references: [id])

  @@unique([userId, daId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("da_feedback")
}

// ─── AI Cost Tracking ─────────────────────────────────────────────────────────

model AiCostLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  phase        String   // embedding|rerank
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  costAud      Decimal  @map("cost_aud")
  weekStart    DateTime @map("week_start") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
  @@map("ai_cost_log")
}

// ─── Ingestion Log ────────────────────────────────────────────────────────────

model IngestionLog {
  id           String   @id @default(cuid())
  council      String
  sourceApi    String   @map("source_api")
  // Approval pathway this log row counts (#10): da|cdc|ssd. Rows are now written
  // per (council, pathway) so drift detection can distinguish a DA-feed drop from
  // a CDC-feed drop rather than averaging the two together. Historical rows are
  // all DA (default 'da').
  approvalPathway String @default("da") @map("approval_pathway")
  daCount      Int      @default(0) @map("da_count")
  runAt        DateTime @default(now()) @map("run_at")
  success      Boolean  @default(true)
  errorMessage String?  @map("error_message")

  @@index([council, runAt(sort: Desc)])
  @@map("ingestion_log")
}

// ─── Team / Billing ──────────────────────────────────────────────────────────

model TeamAccount {
  id          String   @id @default(cuid())
  ownerUserId String   @unique @map("owner_user_id")
  plan        String   @default("solo") // solo|team
  seats       Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")

  owner       User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberships TeamMembership[]

  @@map("team_accounts")
}

model TeamMembership {
  id      String @id @default(cuid())
  teamId  String @map("team_id")
  userId  String @map("user_id")
  role    String @default("seat") // owner|seat

  team TeamAccount @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_memberships")
}

// Stripe webhook idempotency. Replaces the in-memory Set, which was lost on
// every cold start. Stripe retries failed deliveries and does not guarantee
// ordering — without dedupe, a retry on a different instance can re-apply an
// older event and roll subscription state backwards.
model StripeWebhookEvent {
  id         String   @id // Stripe event.id
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("stripe_webhook_events")
}

// ─── Short URLs (SMS) ─────────────────────────────────────────────────────────

model ShortUrl {
  slug      String   @id
  targetUrl String   @map("target_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("short_urls")
}

// ─── Storm briefs (mid-week BOM severe-weather brief, #20) ────────────────────

// One row per (BOM warning, user) actually emailed. The @@unique guarantees a
// storm brief is sent at most once per user per warning id: the cron runs every
// 3 hours and a severe-weather warning stays live across several ticks, so
// without this the same user would be re-emailed on every tick. Rows are cheap
// (one per delivered brief); prune old ones out of band if ever needed.
model StormBrief {
  id        String   @id @default(cuid())
  warningId String   @map("warning_id") // BOM warning identifier (stable per warning)
  userId    String   @map("user_id")
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([warningId, userId])
  @@index([userId])
  @@map("storm_briefs")
}

// ─── Ingestion (Raw Data) ────────────────────────────────────────────────────

model RawDA {
  id              String   @id @default(cuid())
  source          String   // "nsw_planning" | "council_<lga_slug>" | "vendor_panel"
  sourceRecordId  String   @map("source_record_id")
  lgaSlug         String   @map("lga_slug")
  fetchedAt       DateTime @default(now()) @map("fetched_at")
  payload         Json     // raw record as fetched
  contentHash     String   @map("content_hash")  // dedupe
  processed       Boolean  @default(false)

  candidates DigestCandidate[]

  @@unique([source, sourceRecordId])
  @@index([processed, fetchedAt])
  @@index([lgaSlug, fetchedAt])
  @@map("raw_da")
}

// ─── Relevance Pipeline (Digest Candidates) ──────────────────────────────────

model DigestCandidate {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  digestId      String?  @map("digest_id")  // null = not yet bundled into a digest
  rawDaId       String   @map("raw_da_id")
  relevance     Int      // 0-5 (LLM rerank score)
  whyMatched    String   @map("why_matched")
  prefilterScore Float    @map("prefilter_score")
  vectorScore    Float?   @map("vector_score")
  llmModel      String   @map("llm_model")
  scoredAt      DateTime @default(now()) @map("scored_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  digest  Digest? @relation(fields: [digestId], references: [id], onDelete: SetNull)
  rawDa   RawDA   @relation(fields: [rawDaId], references: [id], onDelete: Cascade)

  @@unique([userId, rawDaId])
  @@index([userId, digestId])
  @@map("digest_candidate")
}

// ─── Waitlist (expansion Wave 0 — demand instrument) ─────────────────────────

// Out-of-scope demand capture: a Melbourne roofer or a Sydney plumber lands on
// the waitlist instead of falling off the funnel (docs/25 §2, docs/01c-wedge §3).
// PURE MEASUREMENT — no product implication, no confirmation email (Spam Act:
// v1 stores intent only). (email, trade, region) is unique so repeat submissions
// are idempotent; email is citext in DB (case-insensitive), and the route also
// lowercases trade/region so "Roofing"/"roofing" collapse to one row.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   /// citext in DB (case-insensitive); enforced by the route via toLowerCase()
  trade     String
  region    String
  note      String?
  source    String   // landing | signup
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, trade, region])
  @@index([createdAt])
  @@map("waitlist_entries")
}

// ─── Rate Limiting ────────────────────────────────────────────────────────────

model RateLimit {
  id        String   @id @default(cuid())
  key       String   // e.g. "ip:1.2.3.4:signup" or "account:user_123:login"
  window    DateTime // bucket start
  count     Int      @default(1)

  @@unique([key, window])
  @@index([window])  // for cleanup
  @@map("rate_limit")
}
